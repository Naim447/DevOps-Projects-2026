# Copy to terraform.tfvars and fill in your own values.
# terraform.tfvars is git-ignored — never commit a real one with secrets.
#   cp terraform.tfvars.example terraform.tfvars
aws_region     = "ap-south-1"
environment    = "dev"
project_name   = "project-6"
instance_type  = "t2.micro"
instance_count = 1

# Your EC2 key pair name in this region (create one in the AWS Console first).
key_name = ""

# Your public IP only — find it with: curl -s https://checkip.amazonaws.com
# Example: my_ip = "203.0.113.45/32"
my_ip = "0.0.0.0/0"
